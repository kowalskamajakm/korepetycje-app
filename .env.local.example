# Skopiuj ten plik jako .env.local i uzupełnij wartościami z panelu Supabase
# (Project Settings -> API Keys -> zakładka "Publishable and secret API keys")

NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# UWAGA: bardzo wrazliwy klucz z pelnym dostepem do bazy.
# Bez prefiksu NEXT_PUBLIC_, zeby nigdy nie trafil do przegladarki.
SUPABASE_SECRET_KEY=sb_secret_...

# Wysylka maili (resend.com -> API Keys).
RESEND_API_KEY=re_...

# Losowy sekret chroniacy endpoint /api/cron/reminders przed obcym wywolaniem.
CRON_SECRET=...
